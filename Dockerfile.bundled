# syntax=docker/dockerfile:1.7

# Build stage
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

COPY pyproject.toml uv.lock LICENSE README.md ./
RUN --mount=type=cache,id=castrel-uv-builder-cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev

COPY src ./src
RUN --mount=type=cache,id=castrel-uv-builder-cache,target=/root/.cache/uv,sharing=locked \
    uv pip install .

# Runtime stage
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS runtime-base

WORKDIR /app

RUN --mount=type=cache,id=castrel-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=castrel-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        tini curl ca-certificates gnupg git openjdk-17-jre-headless && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    # Docker CLI (client only) is required for Docker-out-of-Docker: the proxy
    # invokes the mounted /var/run/docker.sock to launch sibling sandbox
    # containers. Without the client binary, sandbox detection reports Docker as
    # unavailable even though the socket is mounted.
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends nodejs docker-ce-cli && \
    # curl/gnupg are only needed to add the NodeSource/Docker repos; remove after install
    apt-get purge -y --auto-remove curl gnupg && \
    rm -rf /var/lib/apt/lists/* \
        /etc/apt/sources.list.d/nodesource.list /etc/apt/keyrings/nodesource.gpg \
        /etc/apt/sources.list.d/docker.list /etc/apt/keyrings/docker.gpg

COPY --from=builder /app/.venv /app/.venv
COPY mcp-bundle.template.yaml /app/mcp-bundle.template.yaml
COPY scripts/generate_mcp_bundle_lock.py /app/scripts/generate_mcp_bundle_lock.py
COPY scripts/install_eclipse_mat.py /app/scripts/install_eclipse_mat.py
COPY config/mcp-empty.json /app/mcp-empty.json

ARG MCP_BUNDLE_STRICT_LATEST=0
RUN if [ "$MCP_BUNDLE_STRICT_LATEST" = "1" ]; then \
        python /app/scripts/generate_mcp_bundle_lock.py \
            --input /app/mcp-bundle.template.yaml \
            --output /app/mcp-bundle.yaml \
            --strict-latest; \
    else \
        python /app/scripts/generate_mcp_bundle_lock.py \
            --input /app/mcp-bundle.template.yaml \
            --output /app/mcp-bundle.yaml; \
    fi && \
    cp /app/mcp-bundle.yaml /app/mcp-bundle.lock.yaml

ARG PG_MCP_VERSION=3.3.6
ARG GIT_MCP_VERSION=2026.1.14
ARG GRAFANA_MCP_VERSION=0.12.1
ARG REDIS_MCP_VERSION=0.5.0
ARG RABBITMQ_MCP_VERSION=2.2.4
RUN --mount=type=cache,id=castrel-uv-mcp-cache,target=/root/.cache/uv,sharing=locked \
    uv venv /opt/mcp-tools/git && \
    uv pip install --python /opt/mcp-tools/git/bin/python "mcp-server-git==${GIT_MCP_VERSION}" && \
    uv venv /opt/mcp-tools/grafana && \
    uv pip install --python /opt/mcp-tools/grafana/bin/python "mcp-grafana==${GRAFANA_MCP_VERSION}" && \
    uv venv /opt/mcp-tools/redis && \
    uv pip install --python /opt/mcp-tools/redis/bin/python "redis-mcp-server==${REDIS_MCP_VERSION}" && \
    uv venv /opt/mcp-tools/rabbitmq && \
    uv pip install --python /opt/mcp-tools/rabbitmq/bin/python "amq-mcp-server-rabbitmq==${RABBITMQ_MCP_VERSION}" && \
    uv venv /opt/mcp-tools/postgresql && \
    uv pip install --python /opt/mcp-tools/postgresql/bin/python "mcp-postgresql-ops==${PG_MCP_VERSION}" && \
    # Clean up bytecode cache and test files in all Python venvs
    find /opt/mcp-tools/git /opt/mcp-tools/grafana /opt/mcp-tools/redis \
         /opt/mcp-tools/rabbitmq /opt/mcp-tools/postgresql \
        \( -type d -name '__pycache__' -o -type d -name 'test' -o -type d -name 'tests' \
           -o -name '*.pyc' -o -name '*.pyo' \) \
        -exec rm -rf {} + 2>/dev/null || true

ARG TIME_MCP_VERSION=1.0.0
ARG FETCH_MCP_VERSION=1.1.2
ARG MEMORY_MCP_VERSION=2026.1.26
ARG K8S_MCP_VERSION=0.0.61
ARG SEQUENTIAL_THINKING_MCP_VERSION=2025.12.18
ARG MYSQL_MCP_VERSION=2.0.8
ARG MAT_MCP_VERSION=0.1.0
ARG MONGODB_MCP_VERSION=1.10.0
ARG ELASTICSEARCH_MCP_VERSION=0.3.1
ARG DBHUB_MCP_VERSION=0.21.2
ARG DOCKER_MCP_VERSION=1.0.0
# All npm MCPs are merged into a single prefix so npm can dedupe shared deps across packages (@modelcontextprotocol/sdk, zod, etc.)
RUN --mount=type=cache,id=castrel-npm-global-cache,target=/root/.npm,sharing=locked \
    npm install -g --prefix /opt/mcp-tools/npm \
        "@guanxiong/mcp-server-time@${TIME_MCP_VERSION}" \
        "@modelcontextprotocol/server-filesystem" \
        "mcp-fetch-server@${FETCH_MCP_VERSION}" \
        "@modelcontextprotocol/server-memory@${MEMORY_MCP_VERSION}" \
        "kubernetes-mcp-server@${K8S_MCP_VERSION}" \
        "@modelcontextprotocol/server-sequential-thinking@${SEQUENTIAL_THINKING_MCP_VERSION}" \
        "@benborla29/mcp-server-mysql@${MYSQL_MCP_VERSION}" \
        "mcp-mat@${MAT_MCP_VERSION}" \
        "mongodb-mcp-server@${MONGODB_MCP_VERSION}" \
        "@elastic/mcp-server-elasticsearch@${ELASTICSEARCH_MCP_VERSION}" \
        "@bytebase/dbhub@${DBHUB_MCP_VERSION}" \
        "mcp-server-docker@${DOCKER_MCP_VERSION}" && \
    # Remove files not needed at runtime from node_modules to shrink image size
    find /opt/mcp-tools/npm/lib/node_modules -type d \( -name 'test' -o -name '__tests__' -o -name '.cache' \) \
        -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/mcp-tools/npm/lib/node_modules -maxdepth 4 \
        \( -name '*.test.js' -o -name '*.spec.js' -o -name '*.test.ts' -o -name '*.spec.ts' \) \
        -delete 2>/dev/null || true && \
    # Remove TypeScript type declarations (.d.ts) and source maps (.map) -- not needed at runtime
    find /opt/mcp-tools/npm/lib/node_modules \
        \( -name '*.d.ts' -o -name '*.d.mts' -o -name '*.d.cts' -o -name '*.js.map' -o -name '*.mjs.map' \) \
        -delete 2>/dev/null || true && \
    # Remove each package's docs and changelogs
    find /opt/mcp-tools/npm/lib/node_modules -maxdepth 2 \
        \( -name 'README*' -o -name 'CHANGELOG*' -o -name 'HISTORY*' -o -name 'LICENSE*' -o -name '*.md' \) \
        -delete 2>/dev/null || true

# @elastic/opentelemetry-node prints diagnostic JSON to stdout at startup, polluting the MCP stdio transport.
# Use find to locate all instances (top-level + each package's nested node_modules) and replace them with a no-op module.
RUN find /opt/mcp-tools/npm -type d -name 'opentelemetry-node' -path '*/@elastic/opentelemetry-node' | \
    while IFS= read -r dir; do \
        rm -rf "$dir" && mkdir -p "$dir" && \
        printf 'module.exports={};\n' > "$dir/index.js" && \
        printf 'module.exports={};\n' > "$dir/register.js" && \
        printf '{"name":"@elastic/opentelemetry-node","version":"0.0.0","main":"./index.js","exports":{".":"./index.js","./*":"./index.js"}}\n' \
            > "$dir/package.json"; \
    done

# kafka-mcp-server is a Go binary with no npm/pip package; download it via Python urllib (avoids installing curl)
ARG KAFKA_MCP_VERSION=2.0.2
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
    python3 -c "import sys,urllib.request,tarfile,io,os;a,v=sys.argv[1],sys.argv[2];u='https://github.com/tuannvm/kafka-mcp-server/releases/download/v'+v+'/kafka-mcp-server_'+v+'_linux_'+a+'.tar.gz';d=urllib.request.urlopen(u).read();tf=tarfile.open(fileobj=io.BytesIO(d),mode='r:gz');tf.extract('kafka-mcp-server','/usr/local/bin');tf.close();os.chmod('/usr/local/bin/kafka-mcp-server',0o755)" \
    "$ARCH" "${KAFKA_MCP_VERSION}"

ARG ECLIPSE_MAT_UPDATE_SITE=https://download.eclipse.org/mat/latest/update-site/
RUN python /app/scripts/install_eclipse_mat.py \
        --source "${ECLIPSE_MAT_UPDATE_SITE}" \
        --output /opt/eclipse-mat && \
    git --version >/dev/null && \
    node --input-type=module -e "import('file:///opt/mcp-tools/npm/lib/node_modules/mcp-mat/dist/src/mat/launcher.js').then((m) => { console.log(m.resolveMatLauncher({ matHome: '/opt/eclipse-mat' })); console.log(m.detectJavaVersion('/usr/bin/java')); })"

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app/src" \
    MAT_HOME="/opt/eclipse-mat" \
    JAVA_PATH="/usr/bin/java" \
    UV_CACHE_DIR="/opt/castrel-cache/uv" \
    npm_config_cache="/opt/castrel-cache/npm" \
    OTEL_SDK_DISABLED=true

FROM runtime-base AS runtime

# All builtin MCPs are already installed globally; prewarming the cache is pointless for the bundled image.
# Just create empty dirs as a fallback write path for custom MCPs.
RUN mkdir -p /opt/castrel-cache/uv /opt/castrel-cache/npm

ENV NPM_CONFIG_PREFER_OFFLINE=true

RUN useradd --create-home --shell /bin/bash castrel && \
    mkdir -p /home/castrel/.castrel && \
    cp /app/mcp-empty.json /home/castrel/.castrel/mcp.json && \
    chown -R castrel:castrel /app /home/castrel /opt/castrel-cache /opt/eclipse-mat \
        /opt/mcp-tools/npm /opt/mcp-tools/git /opt/mcp-tools/grafana /opt/mcp-tools/redis \
        /opt/mcp-tools/rabbitmq /opt/mcp-tools/postgresql

USER castrel
RUN /app/.venv/bin/python -c \
    "from castrel_proxy.security.whitelist import init_whitelist_file; init_whitelist_file()"

# Switch back to root so the entrypoint can reconcile the docker socket group at
# runtime before dropping privileges to castrel via setpriv.
USER root
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import castrel_proxy" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["start"]
