{
  "notes": "Example MCP configuration for Castrel Proxy. Supported transports: stdio, http, sse. Place this file at ~/.castrel/mcp.json",
  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/username/Documents"
      ],
      "env": {}
    },
    "weather": {
      "transport": "http",
      "url": "http://localhost:8000/mcp"
    },
    "internal-sse": {
      "transport": "sse",
      "url": "http://localhost:8001/sse"
    },
    "custom-server": {
      "transport": "stdio",
      "command": "python",
      "args": [
        "/path/to/your/custom_server.py"
      ],
      "env": {}
    }
  }
}

